# ==============================================================================
# ProofOfHustle (PoH) — Master Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env in local root or target subdirectories.
# 2. Fill in your own API keys and private keys.
# 3. NEVER commit real private keys or production secrets to Git!
# ==============================================================================

# --- Monad RPC & Network Settings ---
# Monad Testnet Chain ID: 10143
# Alchemy Monad Testnet RPC URL: https://monad-testnet.g.alchemy.com/v2/<YOUR_KEY>
ALCHEMY_API_KEY=your_alchemy_api_key_here
MONAD_RPC_URL=https://monad-testnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Fallback Monad Public RPCs
MONAD_FALLBACK_RPC_1=https://testnet-rpc.monad.xyz
MONAD_FALLBACK_RPC_2=https://rpc.ankr.com/monad_testnet

# --- Smart Contract Deployment & Verification (contracts/) ---
# Deployer Private Key for Monad Testnet (Hex format with or without 0x prefix)
# CRITICAL: Keep this private! Use a dedicated testnet burner wallet.
PRIVATE_KEY=your_monad_testnet_deployer_private_key_here

# Protocol Fee Treasury (Multi-sig or EOA recipient for 40% protocol fee cut)
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Contract Verification (MonadVision, Socialscan, Monadscan)
# Monadscan API Key for Foundry contract verification
MONADSCAN_API_KEY=your_monadscan_api_key_here
# Note: Devnads multi-explorer API (https://agents.devnads.com/v1/verify) is open/public and requires NO API key.

# --- Envio HyperIndex Real-Time Indexer (indexer/) ---
# Pinned Network: 10143 (Monad Testnet)
# Note: Envio Cloud deploys via GitHub scan ('gh auth login' & 'envio-cloud login'). NO API key required.

# --- Frontend Next.js 15 Web Application (web/) ---
# Privy App ID for embedded passkey & wallet authentication
# Format: 25-character CUID string (get from dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_25_character_privy_app_id

# High-speed synchronous Monad RPC endpoint for frontend transactions
NEXT_PUBLIC_MONAD_RPC_URL=https://monad-testnet.g.alchemy.com/v2/your_alchemy_api_key_here
NEXT_PUBLIC_CHAIN_ID=10143

# Note: MERA Passkey uses browser WebAuthn PRF (Pseudo-Random Function) standard. NO App ID required.
