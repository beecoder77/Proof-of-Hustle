# ==============================================================================
# ProofOfHustle — Next.js 15 Web Application Environment Configuration
# ==============================================================================

# Privy App ID for Passkey and Embedded Wallet Authentication
# Get yours at https://dashboard.privy.io (must be 25-character CUID string)
NEXT_PUBLIC_PRIVY_APP_ID=your_25_character_privy_app_id

# Monad Testnet Alchemy RPC URL for sub-second block queries & eth_sendRawTransactionSync
NEXT_PUBLIC_MONAD_RPC_URL=https://monad-testnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Monad Testnet Chain ID (10143)
NEXT_PUBLIC_CHAIN_ID=10143

# Note: MERA Passkey uses browser WebAuthn PRF (Pseudo-Random Function) standard.
# It runs 100% client-side via Web Crypto API (AES-GCM-256). NO App ID or external SaaS account required.
